  "obligations": [
    {
      "id": "obligation:df9ffaba-4d37-429e-89bd-3406023b4b5d",
      "kind": "headline",
      "summary": "Accuracy: Pr[output ≠ ⊥ ∧ (1-ε)F0 ≤ output ≤ (1+ε)F0] ≥ 1-δ.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "materialized"
    },
    {
      "id": "obligation:1629b1bb-17d4-4333-82a5-52306c70bce9",
      "kind": "headline",
      "summary": "Worst-case space: |X| ≤ thresh at every point of every run of Algorithm 1.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:14495ec1-94f3-4073-9528-978eb0bcc661",
      "kind": "headline",
      "summary": "Space in bits is O(ε^-2 · log n · (log m + log 1/δ)), via thresh · ⌈log₂ n⌉.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:b521cb66-6d89-46ea-a1de-4b52018ad851",
      "kind": "headline",
      "summary": "Expected running time O(m) (O(1) per element), absolute constant, under O(1)-cost dictionary operations.",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "planned"
    },
    {
      "id": "obligation:91455bea-3137-4954-9ccf-43a6b1e05694",
      "kind": "implementation",
      "summary": "Every loop iteration costs O(1) except those executing line final-throw, which cost an additional O(thresh).",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Program.",
      "owner": "Model/Program",
      "status": "planned"
    },
    {
      "id": "obligation:f1d74399-8dd6-4441-ad6a-c40471b926a3",
      "kind": "headline",
      "summary": "With T = number of throw executions, E[T] ≤ 2m/thresh (Wald: E[ΣR_j] = E[T]·thresh/2 and ΣR_j ≤ m).",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:65ebbd99-ef95-41c5-952e-6b791dc3fe75",
      "kind": "headline",
      "summary": "ΣR_j ≤ m on every run (X grows by at most one per iteration).",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:1074f781-5a33-4f2e-9819-9c697073a767",
      "kind": "headline",
      "summary": "Pr[Error] ≤ Pr[Fail] + Pr[Error ∩ ¬Fail].",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:09862142-3933-4728-8758-4dc6f4578107",
      "kind": "headline",
      "summary": "Claim lm:fail: Pr[Fail] ≤ δ/8 (union bound over j of Pr[Fail_j] ≤ 2^{-thresh}).",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:f5b10fae-7fc7-42b7-8961-b6551ba8057e",
      "kind": "headline",
      "summary": "Claim claim:errfail: Pr[Error ∩ ¬Fail] ≤ δ/2, via Pr[Error ∩ ¬Fail] ≤ Pr[Error_2] for the relaxed Algorithm 2 (identical behaviour on ¬Fail).",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:882dc1e1-b334-493d-8a5b-e71d7892c29d",
      "kind": "headline",
      "summary": "Claim cl:loop: in Algorithm 3 every element of S_i is in Y_k independently with probability 2^{-k}.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:a813dac7-6525-4258-b145-155e438461c0",
      "kind": "headline",
      "summary": "Coupling: (p_j, X_j) of Algorithm 2 equals (p_j, Y_{k,j}) of Algorithm 3 when p_j = 2^{-k}; and p ≥ 2^{-m} always.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:55f67af1-bba5-4838-9573-b293dcc2af47",
      "kind": "headline",
      "summary": "Equation eq:Yellj: E|Y_{k,j}| = 2^{-k}|S_j| ≤ 2^{-k} F0.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:241b71ea-856c-4064-b34a-949d5b2dd444",
      "kind": "headline",
      "summary": "Claim lm:error-fail: Pr[Error_2] ≤ δ/2, split as Pr[Bad_2] ≤ δ/4 and Pr[Error_2 ∩ ¬Bad_2] ≤ δ/4.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:4952edff-38d5-4b72-acd1-d6563bd9b729",
      "kind": "headline",
      "summary": "Chernoff Fact: for independent 0/1 variables with sum V and mean μ, Pr(|V-μ| ≥ βμ) ≤ 2e^{-β²μ/(2+β)}.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:1b406dfc-25d5-4413-b01e-5d10b188532e",
